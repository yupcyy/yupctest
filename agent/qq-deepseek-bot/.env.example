DEEPSEEK_API_KEY=replace_with_your_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
BUILDING_STORAGE_PATH=data/building/tasks
BUILDING_TOKEN_TTL=86400
BUILDING_ADMIN_PASSWORD=change_me
GOMOKU_STORAGE_PATH=data/gomoku/games
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=replace_with_napcat_connection_token
# Optional comma-separated user/group IDs; empty = allow all
ALLOWED_USERS=
ALLOWED_GROUPS=
MAX_HISTORY_TURNS=10
MAX_REPLY_CHARS=1500
MAX_CONCURRENT_REQUESTS=3
SYSTEM_PROMPT=你是一个在QQ中回复消息的AI助手。请用自然、清晰、简洁的中文回答。

# Pydantic AI is the default runtime; false keeps legacy plain chat.
ENABLE_AGENT=true
DATABASE_TYPE=sqlite
DATABASE_PATH=data/agent.sqlite3
ENABLE_REMOTE_BACKUP=false
REMOTE_BACKUP_INTERVAL=300
ENABLE_PERSISTENT_MEMORY=true
ENABLE_LONG_TERM_MEMORY=true
ENABLE_OWNER_STYLE_LEARNING=true
MASTER_QQ_ID=
PLUGIN_CONFIG=plugins.json
# Explicit opt-in: remember recent group messages and occasionally join the conversation.
PROACTIVE_GROUPS=
PROACTIVE_PROBABILITY=0.03
PROACTIVE_COOLDOWN=1800
# 主人私聊默认最多约每 12 小时一次；/主动 减少 后约每 36 小时一次。
OWNER_PROACTIVE_COOLDOWN=14400
PROACTIVE_TIMEZONE_OFFSET=8
# NapCat AI 语音角色编号；私聊复用语音时还需一个机器人所在群号。
NAPCAT_VOICE_CHARACTER=
NAPCAT_VOICE_SOURCE_GROUP=
# Minecraft Java 版服务器状态查询。
MC_SERVER_HOST=
MC_SERVER_PORT=25565
MC_STATUS_TIMEOUT=5
# 可选：Paper/Spigot 服务端启用 RCON 后提供 TPS/MSPT。
MC_RCON_HOST=
MC_RCON_PORT=25575
MC_RCON_PASSWORD=

# Allow members to edit their own private profile (owner can always manage profiles).
ENABLE_SELF_PROFILE=false
